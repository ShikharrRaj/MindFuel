{
  "name": "mindfuel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MindFuel — an AI wellness companion for students preparing for high-stakes exams (NEET/JEE/CAT/UPSC).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",

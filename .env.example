# Copy to .env.local for local dev with `vercel dev`, and set the same key in
# your Vercel project settings (Environment Variables) for production.
#
# Get a free key at https://aistudio.google.com/apikey
# This key is used ONLY by the server-side functions in /api and is never
# exposed to the browser.
GEMINI_API_KEY=your_google_ai_studio_key_here

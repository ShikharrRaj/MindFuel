# Copy to .env.local for local dev (`npm run dev` reads it), and set the same
# values in Vercel → Project → Settings → Environment Variables.
# Server-only values are read by the functions in /api and never reach the
# browser. Only VITE_* values are built into the page, so never put a secret
# in a VITE_* variable.

# --- Required -----------------------------------------------------------------
# Gemini API key: https://aistudio.google.com/apikey
# Production: use a PAID-tier (billing-enabled) project. On the free tier Google
# may use prompts to improve its products, which the privacy policy rules out.
GEMINI_API_KEY=your_google_ai_studio_key_here

# --- AI model (optional) --------------------------------------------------------
# Defaults: gemini-3.1-flash-lite, falling back to gemini-3.5-flash-lite when the
# first is overloaded, rate-limited or slow. Set GEMINI_FALLBACK_MODEL=none to
# turn the fallback off.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Rate limiting (REQUIRED on Vercel) ----------------------------------------
# On a Vercel deployment the AI features stay PAUSED until both Upstash and the
# salt are set, because per-instance limits cannot cap the bill. Calm now,
# helplines and every on-device tool work regardless. Local dev needs neither.
# Upstash Redis REST credentials (Vercel Marketplace → Upstash); the
# KV_REST_API_* names also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Secret key for hashing client IPs (any long random string, e.g. `openssl rand -hex 32`).
# RATE_LIMIT_SALT=
# Ceilings on AI calls across all users per UTC day, per feature.
# AI_DAILY_LIMIT_ANALYZE=2000
# AI_DAILY_LIMIT_CHAT=4000
# Escape hatch: run on Vercel with per-instance limits only (not recommended).
# RATE_LIMIT_ALLOW_MEMORY=1

# --- Shown on the privacy policy and terms (public) -----------------------------
# VITE_OPERATOR_NAME=
# VITE_CONTACT_EMAIL=

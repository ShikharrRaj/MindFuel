{
  "$comment": "Canonical, machine-readable source of truth for role boundaries and the handoff DAG. Consumed by scripts/lint-role-boundaries.mjs and scripts/lint-handoff-chain.mjs. Every .claude/agents/*.md role file MUST have an entry here. writeGlobs = paths a role may Write/Edit; readOnly roles have NO writeGlobs and must omit Write/Edit from their subagent `tools`. See docs/engineering-os-standard.md \u00a76.",
  "externalInputs": [
    "ceo-request",
    "prd-raw"
  ],
  "sharedDomains": [
    {
      "path": "prisma/schema.prisma",
      "owners": [
        "backend-lead",
        "database"
      ],
      "rule": "Backend owns application-facing models; Database owns indexes/migrations/tuning. Same file -> tool wall cannot separate. Advisory + arbitration only.",
      "arbiter": "engineering-manager"
    },
    {
      "path": "src/components/**",
      "owner": "frontend-lead",
      "advisors": [
        "accessibility",
        "seo",
        "performance",
        "animation"
      ],
      "rule": "Cross-cutting roles emit findings on the same React files; they do NOT edit. Frontend Lead applies. EM arbitrates disputes.",
      "arbiter": "engineering-manager"
    },
    {
      "path": "package.json",
      "owners": [
        "frontend-lead",
        "backend-lead"
      ],
      "rule": "Dependencies are shared; each lead adds only deps for its own domain. Dependency vetting via the dependency-audit skill.",
      "arbiter": "engineering-manager"
    }
  ],
  "nestedDomains": [
    {
      "path": "src/dev/**",
      "owner": "backend-lead",
      "lead": "frontend-lead",
      "rule": "Vite dev plugin that runs the api/ Edge handlers locally \u2014 server code, owned by backend."
    },
    {
      "path": "src/test/**",
      "owner": "qa-automation",
      "lead": "frontend-lead",
      "rule": "Shared test setup/fixtures. Co-located *.test.ts(x) stay with the module owner."
    },
    {
      "path": "src/ai/**",
      "owner": "ai-platform-lead",
      "lead": "frontend-lead",
      "rule": "Target home for AI modules once extracted from src/lib."
    },
    {
      "path": "src/ai/prompts/**",
      "owner": "prompt-engineer",
      "lead": "ai-platform-lead",
      "rule": "Prompt authoring carve-out."
    },
    {
      "path": "src/ai/evals/**",
      "owner": "ai-evaluation",
      "lead": "ai-platform-lead",
      "rule": "Eval harness carve-out."
    },
    {
      "path": "src/lib/safety*",
      "owner": "ai-platform-lead",
      "lead": "frontend-lead",
      "rule": "Crisis detection + helplines. Safety-critical: changes need security-reviewer sign-off."
    },
    {
      "path": "src/lib/aiError*",
      "owner": "ai-platform-lead",
      "lead": "frontend-lead",
      "rule": "Gemini error classification / retry policy."
    },
    {
      "path": "src/lib/context*",
      "owner": "ai-platform-lead",
      "lead": "frontend-lead",
      "rule": "User-context assembly fed to the model."
    },
    {
      "path": "src/lib/prompts*",
      "owner": "prompt-engineer",
      "lead": "ai-platform-lead",
      "rule": "System prompts + structured-output schema."
    }
  ],
  "roles": {
    "engineering-manager": {
      "tier": "orchestrator",
      "writeGlobs": [
        "projects/**/plan/**",
        "projects/**/escalations/**"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "ceo-request",
        "prd-approved",
        "review-findings",
        "security-findings",
        "qa-report",
        "design-findings",
        "dependency-report",
        "cost-findings"
      ],
      "produces": [
        "delivery-plan",
        "release-decision",
        "execution-plan",
        "retro-report"
      ]
    },
    "product-manager": {
      "tier": "lead",
      "writeGlobs": [
        "projects/**/prd/**"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "ceo-request",
        "prd-raw"
      ],
      "produces": [
        "prd-approved"
      ]
    },
    "staff-architect": {
      "tier": "lead",
      "writeGlobs": [
        "projects/**/arch/**"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "delivery-plan",
        "prd-approved",
        "research-report"
      ],
      "produces": [
        "architecture-spec",
        "adr"
      ]
    },
    "frontend-lead": {
      "tier": "lead",
      "writeGlobs": [
        "src/**",
        "index.html",
        "public/**",
        "vite.config.ts",
        "tsconfig*.json",
        "eslint.config.js",
        "package.json"
      ],
      "readOnly": false,
      "disallowed": [],
      "consumes": [
        "architecture-spec",
        "ui-spec",
        "api-contract"
      ],
      "produces": [
        "frontend-impl"
      ]
    },
    "backend-lead": {
      "tier": "lead",
      "writeGlobs": [
        "api/**",
        "src/dev/**",
        "package.json",
        "prisma/schema.prisma"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/components/**)",
        "Write(src/lib/**)"
      ],
      "consumes": [
        "architecture-spec"
      ],
      "produces": [
        "backend-impl",
        "api-contract"
      ]
    },
    "ai-platform-lead": {
      "tier": "lead",
      "writeGlobs": [
        "src/ai/**",
        "src/lib/safety*",
        "src/lib/aiError*",
        "src/lib/context*"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/components/**)",
        "Write(api/**)"
      ],
      "consumes": [
        "architecture-spec",
        "prompt-spec"
      ],
      "produces": [
        "ai-impl"
      ]
    },
    "uiux-lead": {
      "tier": "lead",
      "writeGlobs": [
        "projects/**/design/**"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "prd-approved",
        "architecture-spec"
      ],
      "produces": [
        "ui-spec"
      ]
    },
    "database": {
      "tier": "specialist",
      "writeGlobs": [
        "prisma/migrations/**",
        "prisma/schema.prisma"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/app/**)",
        "Write(src/ai/**)"
      ],
      "consumes": [
        "architecture-spec",
        "api-contract"
      ],
      "produces": [
        "schema-migration"
      ]
    },
    "devops": {
      "tier": "specialist",
      "writeGlobs": [
        "infra/**",
        ".github/**",
        "docker/**",
        "Dockerfile",
        "vercel.json",
        "*.yml",
        "*.yaml"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "backend-impl",
        "frontend-impl"
      ],
      "produces": [
        "deploy-config",
        "dependency-report"
      ]
    },
    "qa-automation": {
      "tier": "specialist",
      "writeGlobs": [
        "tests/**",
        "e2e/**",
        "src/test/**"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "frontend-impl",
        "backend-impl",
        "ai-impl",
        "prd-approved"
      ],
      "produces": [
        "test-suite",
        "qa-report"
      ]
    },
    "security-reviewer": {
      "tier": "specialist",
      "writeGlobs": [],
      "readOnly": true,
      "disallowed": [
        "Write",
        "Edit"
      ],
      "consumes": [
        "backend-impl",
        "frontend-impl",
        "ai-impl",
        "deploy-config"
      ],
      "produces": [
        "security-findings"
      ]
    },
    "code-reviewer": {
      "tier": "specialist",
      "writeGlobs": [],
      "readOnly": true,
      "disallowed": [
        "Write",
        "Edit"
      ],
      "consumes": [
        "frontend-impl",
        "backend-impl",
        "ai-impl"
      ],
      "produces": [
        "review-findings"
      ]
    },
    "performance": {
      "tier": "specialist",
      "writeGlobs": [],
      "readOnly": true,
      "disallowed": [
        "Write",
        "Edit"
      ],
      "consumes": [
        "frontend-impl",
        "backend-impl"
      ],
      "produces": [
        "perf-findings",
        "cost-findings"
      ]
    },
    "prompt-engineer": {
      "tier": "specialist",
      "writeGlobs": [
        "src/ai/prompts/**",
        "src/lib/prompts*"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/app/**)",
        "Write(src/server/**)"
      ],
      "consumes": [
        "architecture-spec",
        "ai-impl"
      ],
      "produces": [
        "prompt-spec"
      ]
    },
    "ai-evaluation": {
      "tier": "specialist",
      "writeGlobs": [
        "src/ai/evals/**"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/app/**)",
        "Write(src/server/**)"
      ],
      "consumes": [
        "ai-impl",
        "prompt-spec"
      ],
      "produces": [
        "eval-report"
      ]
    },
    "accessibility": {
      "tier": "specialist",
      "writeGlobs": [],
      "readOnly": true,
      "disallowed": [
        "Write",
        "Edit"
      ],
      "consumes": [
        "frontend-impl",
        "ui-spec"
      ],
      "produces": [
        "a11y-findings"
      ]
    },
    "documentation": {
      "tier": "specialist",
      "writeGlobs": [
        "docs/**",
        "README.md"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "delivery-plan",
        "architecture-spec",
        "frontend-impl",
        "backend-impl"
      ],
      "produces": [
        "docs-artifact"
      ]
    },
    "seo": {
      "tier": "specialist",
      "writeGlobs": [],
      "readOnly": true,
      "disallowed": [
        "Write",
        "Edit"
      ],
      "consumes": [
        "frontend-impl",
        "ui-spec"
      ],
      "produces": [
        "seo-findings"
      ]
    },
    "animation": {
      "tier": "specialist",
      "writeGlobs": [],
      "readOnly": true,
      "disallowed": [
        "Write",
        "Edit"
      ],
      "consumes": [
        "ui-spec",
        "frontend-impl"
      ],
      "produces": [
        "animation-spec"
      ]
    },
    "research": {
      "tier": "specialist",
      "writeGlobs": [
        "projects/**/research/**"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "prd-approved"
      ],
      "produces": [
        "research-report"
      ]
    },
    "design-guardian": {
      "tier": "specialist",
      "writeGlobs": [],
      "readOnly": true,
      "disallowed": [
        "Write",
        "Edit"
      ],
      "consumes": [
        "frontend-impl",
        "ui-spec"
      ],
      "produces": [
        "design-findings"
      ]
    },
    "git-operations": {
      "tier": "specialist",
      "writeGlobs": [
        "CHANGELOG.md"
      ],
      "readOnly": false,
      "disallowed": [
        "Write(src/**)",
        "Edit(src/**)"
      ],
      "consumes": [
        "release-decision"
      ],
      "produces": [
        "release-notes"
      ]
    }
  },
  "$factory": "Software Factory v2.0 (2026-07-24): +research, +design-guardian (read-only), +git-operations. Pipeline codified in playbooks/software-factory.md. Planning/dependency/cost/observability/analytics/knowledge/retro are SKILLS run by existing owners, not roles.",
  "$project": "Tuned for MindFuel (Vite + React 19 SPA, Vercel Edge functions in api/, Gemini via @google/genai). frontend-lead owns src/** broadly; AI modules, dev API shim and test setup are nested carve-outs. Re-tune after the production architecture ADR fixes the target (monorepo) layout."
}
